#!/usr/bin/env bash
# mia-rig: auto-rig a humanoid GLB with Make-It-Animatable (rig/README.md). Runs rig/.conda with a cleaned
# environment and the repo's Blender (deps/blender, or $BLENDER).
# CUDA_VISIBLE_DEVICES is empty: MIA would take the GPU when it sees one, but its fixed-size point sample runs as fast
# on the CPU, and hiding the GPU keeps it free for the GPU tools and makes the rig env independent of the GPU model.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
python="$root/rig/.conda/bin/python"
[[ -x $python ]] || { echo "mia-rig: not installed, run $root/setup.sh rig" >&2; exit 1; }
exec env -u LD_LIBRARY_PATH -u PYTHONPATH -u VIRTUAL_ENV CUDA_VISIBLE_DEVICES= "$python" "$root/rig/mia_rig.py" "$@"

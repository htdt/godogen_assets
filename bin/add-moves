#!/usr/bin/env bash
# add-moves: put a baked Kimodo move set onto a rigged character (motion/README.md). CPU only, ~1 min.
#
#   add-moves RIG.glb [--baked DIR] [-o OUT.glb] [--speak LINE.wav [-t LINE.txt]] [--json]
#
# RIG.glb is a mia-rig or lipsync output (Mixamo names, T-pose bind, no animation). Steps (kimodo-practical):
#   certify.mjs              the rig retargets cleanly (Stage 1 gates); a rig that fails gets regenerated, not patched
#   qa_endeffectors --gate   feet flat and hands tracking on every move
#   prebake.mjs              one glTF animation per move (in place) -> OUT.glb + <name>_rootmotion.json
#                            (+ OUT's .certificate.json; mouth rigs also get OUT's .face.json for lipsync --add)
#   (mouth rigs) --speak     lip-sync clip "speak" on top; the moves never key the jaw
# Default move set: motion/kimodo-practical/kimodo/out/web_mk (the 17-move MK set, see motion/README.md).
# Default OUT: <RIG dir>/<name>_moves.glb (<name> = RIG name without _rigged / _mouth).
# stdout: OUT path (or a JSON object with --json); progress on stderr; exit 0 / 1 (1 = certification or gate failed).
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
KP=$root/motion/kimodo-practical
[[ ${1:-} = -h || ${1:-} = --help ]] && { sed -n '2,14p' "$0" | cut -c3-; exit 0; }
BLENDER=${BLENDER:-$root/deps/blender/blender}
[[ -d $KP/node_modules ]] || { echo "add-moves: not installed, run $root/setup.sh motion" >&2; exit 1; }
unset LD_LIBRARY_PATH PYTHONPATH VIRTUAL_ENV

baked="$KP/kimodo/out/web_mk"; out=""; wav=""; text=""; json=0; pos=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --baked) baked=$(readlink -f "$2"); shift 2;;
    -o) out=$2; shift 2;;
    --speak) wav=$(readlink -f "$2"); shift 2;;
    -t) text=$(readlink -f "$2"); shift 2;;
    --json) json=1; shift;;
    -h|--help) sed -n '2,14p' "$0" | cut -c3-; exit 0;;
    -*) echo "add-moves: unknown option $1" >&2; exit 1;;
    *) pos+=("$1"); shift;;
  esac
done
[[ ${#pos[@]} -eq 1 ]] || { echo "usage: add-moves RIG.glb [--baked DIR] [-o OUT.glb] [--speak LINE.wav [-t LINE.txt]]" >&2; exit 1; }
rig=$(readlink -f "${pos[0]}")
[[ -f $baked/manifest.json ]] || { echo "add-moves: no baked move set at $baked (motion/README.md)" >&2; exit 1; }
dir=$(dirname "$rig"); name=$(basename "$rig" .glb); name=${name%_rigged}; name=${name%_mouth}
out=$(readlink -f "${out:-$dir/${name}_moves.glb}")
rootmotion="${out%.glb}_rootmotion.json"; rootmotion=${rootmotion/_moves_rootmotion/_rootmotion}
certificate="${out%.glb}.certificate.json"
face="${rig%.glb}.face.json"
[[ -n $wav && ! -f $face ]] && { echo "add-moves: --speak needs a mouth rig (lipsync output with $face)" >&2; exit 1; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

clips=$(ls "$baked"/*.json | grep -v manifest | paste -sd, -)
cd "$KP"
node certify.mjs "$rig" --clips "$clips" --out "$certificate" > "$tmp/certify.log" 2>&1 \
  || { tail -20 "$tmp/certify.log" >&2; echo "add-moves: certification failed" >&2; exit 1; }
echo "certify: ok" >&2
node qa_endeffectors.mjs "$rig" "$baked" --gate > "$tmp/gate.log" 2>&1 \
  || { tail -20 "$tmp/gate.log" >&2; echo "add-moves: end-effector gate failed" >&2; exit 1; }
grep -E "aggregate|GATES" "$tmp/gate.log" >&2
node prebake.mjs "$rig" --manifest "$baked/manifest.json" --out "$out" --rootmotion "$rootmotion" > "$tmp/prebake.log" 2>&1 \
  || { tail -20 "$tmp/prebake.log" >&2; exit 1; }
tail -1 "$tmp/prebake.log" >&2

if [[ -f $face ]]; then
  cp "$face" "${out%.glb}.face.json"   # lipsync --add finds it next to the GLB
  if [[ -n $wav ]]; then
    args=("$out" "$wav" "$out" --face "$face"); [[ -n $text ]] && args+=(--text "$text")
    "$BLENDER" -b --factory-startup -P "$root/lipsync/lipsync.py" -- "${args[@]}" > "$tmp/lipsync.log" 2>&1 \
      || { tail -20 "$tmp/lipsync.log" >&2; exit 1; }
    grep -E "^WROTE|removed" "$tmp/lipsync.log" >&2 || true
    rm -f "${out%.glb}.rhubarb.json"
  fi
fi

if [[ $json = 1 ]]; then
  python3 -c 'import json, sys; print(json.dumps(dict(zip(["output", "rootmotion", "certificate", "baked"], sys.argv[1:]))))' \
    "$out" "$rootmotion" "$certificate" "$baked"
else
  echo "$out"
fi

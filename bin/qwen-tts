#!/usr/bin/env bash
# qwen-tts: Qwen3-TTS voice lines (design / clone / batch) (voice/README.md).
# Starts from an empty environment (env -i) so the caller's venv, PYTHONPATH or LD_LIBRARY_PATH cannot interfere;
# only HOME, a minimal PATH, locale and HF / CUDA variables pass through.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
python="$root/voice/.venv/bin/python"
[[ -x $python ]] || { echo "qwen-tts: not installed, run $root/setup.sh voice" >&2; exit 1; }

passthrough=(HOME="$HOME" PATH="/usr/local/bin:/usr/bin:/bin" LANG="${LANG:-C.UTF-8}" TERM="${TERM:-dumb}")
for var in HF_HOME HF_TOKEN HF_HUB_OFFLINE HF_HUB_CACHE CUDA_VISIBLE_DEVICES; do
  if [[ -n "${!var:-}" ]]; then passthrough+=("$var=${!var}"); fi
done
exec env -i "${passthrough[@]}" "$python" "$root/voice/cli.py" "$@"

#!/usr/bin/env bash
# stable-audio: Stable Audio 3 small-sfx sound effects (sfx/README.md).
# Starts from an empty environment (env -i) so the caller's venv, PYTHONPATH or LD_LIBRARY_PATH cannot interfere;
# only HOME, a minimal PATH, locale and HF / CUDA variables pass through.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$root/tools/launcher.sh"
python="$root/sfx/.venv/bin/python"
[[ -x $python ]] || { echo "stable-audio: not installed, run $root/setup.sh sfx" >&2; exit 1; }

passthrough=(PYTHONNOUSERSITE=1 HOME="$HOME" PATH="/usr/local/bin:/usr/bin:/bin" LANG="${LANG:-C.UTF-8}" TERM="${TERM:-dumb}")
for var in HF_HOME HF_TOKEN HF_HUB_OFFLINE HF_HUB_CACHE CUDA_VISIBLE_DEVICES; do
  if [[ -n "${!var:-}" ]]; then passthrough+=("$var=${!var}"); fi
done
exec env -i "${passthrough[@]}" "$python" "$root/sfx/cli.py" "$@"
